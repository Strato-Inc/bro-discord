# Discord Bot Token (Required)
DISCORD_TOKEN=your_bot_token_here

# Bot Name (default: "Bro")
BOT_NAME=Bro

# Role names required to give/remove points (comma-separated, default: "PointGiver")
# Users with ANY of these roles can modify points
POINT_GIVER_ROLE_NAMES=b28,b27,b26

# Database file path (default: "./points.db")
DATABASE_FILE=./points.db
